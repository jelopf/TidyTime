<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:TidyTime.ViewModels"
             mc:Ignorable="d" d:DesignWidth="360" d:DesignHeight="640"
             x:Class="TidyTime.Views.GameMenuView"
             x:DataType="vm:GameMenuViewModel">

    <Grid Background="White">
        <Button Command="{Binding GoBackCommand}"
        HorizontalAlignment="Left"
        VerticalAlignment="Top"
        Width="11.56" Height="20.02"
        Background="Transparent"
        BorderThickness="0"
        Margin="30,31,0,0"
        Padding="0"
        FontSize="20">
            <Image Source="/Assets/Images/Return.png" Stretch="UniformToFill"/>
        </Button>

        <Grid Height="451"
        Margin="0,62,0,0"
        VerticalAlignment="Top">
            <Border Background="#1CDBB5"
            Height="433"
            CornerRadius="16"
            VerticalAlignment="Bottom">
                <Border.Background>
                    <ImageBrush Source="/Assets/Images/BackMenuGame.png" Stretch="UniformToFill"/>
                </Border.Background>
                <StackPanel Margin="30,47,30,30">
                    <StackPanel Orientation="Horizontal"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                        <!--Кнопка "Змейка"-->
                        <StackPanel>
                            <Button Background="Transparent"
                            Width="135"
                            Height="135"
                            HorizontalAlignment="Center"
                            HorizontalContentAlignment="Center"
                            VerticalContentAlignment="Center"
                            CornerRadius="16"
                            Command="{Binding PlaySnakeCommand}">
                                <Image Source="/Assets/Images/MenuGameSnake.png" Stretch="UniformToFill"/>
                            </Button>

                            <StackPanel Orientation="Horizontal"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Center">
                                <TextBlock Text="Змейка"
                                FontSize="14"
                                FontFamily="{StaticResource ComfortaaMedium}"
                                Margin="0,12,0,0"/>
                                <TextBlock Text=" ( 20 "
                                FontSize="14"
                                FontFamily="{StaticResource ComfortaaMedium}"
                                Margin="0,12,0,0"/>
                                <Ellipse Width="16" 
                                Height="16" 
                                Fill="#FFCC00"
                                Margin="0,12,0,0"/>
                                <TextBlock Text=" )"
                                FontSize="14"
                                FontFamily="{StaticResource ComfortaaMedium}"
                                Margin="0,12,0,0"/>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>

                    <Grid Margin="0,30,0,0"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Center">
                        <!--Кнопка "Мемори"-->
                        <StackPanel VerticalAlignment="Center"
                        HorizontalAlignment="Center">
                            <Button Background="Transparent"
                            Width="135"
                            Height="135"
                            HorizontalAlignment="Center"
                            HorizontalContentAlignment="Center"
                            VerticalContentAlignment="Center"
                            BorderThickness="0"
                            CornerRadius="16"
                            Command="{Binding PlayMemoryCommand}">
                                <Image Source="/Assets/Images/MenuGameMemory.png" Stretch="UniformToFill"/>
                            </Button>

                            <StackPanel Orientation="Horizontal"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Center">
                                <TextBlock Text="Мемори"
                                FontSize="14"
                                FontFamily="{StaticResource ComfortaaMedium}"
                                Margin="0,12,0,0"/>
                                <TextBlock Text=" ( 20 "
                                FontSize="14"
                                FontFamily="{StaticResource ComfortaaMedium}"
                                Margin="0,12,0,0"/>
                                <Ellipse Width="16" 
                                Height="16" 
                                Fill="#FFCC00"
                                Margin="0,12,0,0"/>
                                <TextBlock Text=" )"
                                FontSize="14"
                                FontFamily="{StaticResource ComfortaaMedium}"
                                Margin="0,12,0,0"/>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!--Баланс-->
            <Border Background="#B2FFD8"
            Width="94"
            Height="35"
            VerticalAlignment="Top"
            CornerRadius="16"
            Padding="0,10,0,9">
                <StackPanel Orientation="Horizontal"
                VerticalAlignment="Center"
                HorizontalAlignment="Center">
                    <TextBlock Text="{Binding TotalCoinsDisplay}"
                    HorizontalAlignment="Center"
                    FontSize="14"
                    FontFamily="{StaticResource ComfortaaBold}"
                    Margin="0,0,6,0"/>

                    <Ellipse Width="16" 
                    Height="16" 
                    Fill="#FFCC00"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>